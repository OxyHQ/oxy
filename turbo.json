{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["bun.lock", "package.json", "bunfig.toml", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "lib/**", ".next/**", ".output/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/scripts/**",
        "$TURBO_ROOT$/packages/app-preset/metro/source-stamp.js"
      ]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
