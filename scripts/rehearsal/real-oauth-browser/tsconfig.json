{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "../../..",
    "paths": {
      "react": ["packages/auth/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["packages/auth/node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom/client": ["packages/auth/node_modules/@types/react-dom/client.d.ts"],
      "@oxy.so/services": ["packages/services/lib/typescript/module/index.d.ts"],
      "*": ["packages/auth/node_modules/*", "node_modules/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["main.tsx"]
}
