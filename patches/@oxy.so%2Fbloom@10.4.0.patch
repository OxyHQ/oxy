+  return (
+    <Card
+      radius={radius}
+      elevation="none"
+      testID={testID}
+      style={[
+        {
+          width: '100%',
+          minWidth: 0,
+          flexDirection: 'column',
+          paddingLeft: 16,
+          paddingRight: 16,
+          paddingTop: 10,
+          paddingBottom: 16,
+        },
+        style,
+      ]}
+    >
+      {usage ? (
+        <UsageSection
+          usage={usage}
+          palette={palette}
+          format={formatValue}
+          expanded={expanded}
+          onToggle={toggle}
+          label={title ?? labels?.usage ?? messages.usage}
+          freeSpaceLabel={labels?.freeSpace ?? messages.freeSpace}
+          testID={testID}
+        />
+      ) : title || fallback ? (
+        <View style={{ gap: 6 }}>
