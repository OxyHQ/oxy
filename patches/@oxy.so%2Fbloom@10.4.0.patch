+  return (
+    <>
+      <HoverRow
+        palette={palette}
+        onPress={onToggle}
+        expanded={expanded}
+        accessibilityLabel={`${label}, ${readout} ${percent}`}
+        style={{ justifyContent: 'space-between', gap: 12, paddingTop: 4, paddingBottom: 4 }}
+        testID={part(testID, 'context-toggle')}
