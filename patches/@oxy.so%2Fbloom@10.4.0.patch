+            <Text style={[BODY_MEDIUM, { color: palette.textSecondary }]}>{title}</Text>
+          ) : null}
+          {fallback}
+        </View>
+      ) : null}
+
+      {usage && showPlan ? (
+        <View
+          style={{
+            marginTop: 12,
+            marginBottom: 12,
+            height: 1,
+            width: '100%',
+            backgroundColor: palette.separator,
+          }}
+        />
+      ) : null}
+
+      {showPlan ? (
+        <>
+          <View
+            style={{
+              flexDirection: 'row',
+              alignItems: 'center',
+              justifyContent: 'space-between',
+              gap: 12,
+              paddingTop: 4,
+              paddingBottom: 4,
+            }}
+          >
