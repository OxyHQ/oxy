+            </View>
+          ) : null}
+        </View>
+      </Collapse>
+    </>
+  );
+}
+
+/**
+ * The plan arrow: a 24px `rounded-md` link, tertiary icon that turns
+ * secondary over a `background-secondary-hover` fill.
+ */
+function PlanLink({
+  palette,
+  onPress,
+  accessibilityLabel,
+  testID,
