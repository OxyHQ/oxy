+      <Text numberOfLines={1} style={[BODY_REGULAR, { flex: 1, minWidth: 0, color: palette.text }]}>
+        {label}
+      </Text>
+      <Text style={[BODY_REGULAR, TABULAR, { color: palette.textTertiary }]}>{value}</Text>
+      <Text
+        style={[
+          BODY_MEDIUM,
+          TABULAR,
+          { width: SHARE_WIDTH, textAlign: 'right', color: palette.text },
+        ]}
+      >
+        {share}
+      </Text>
+    </View>
