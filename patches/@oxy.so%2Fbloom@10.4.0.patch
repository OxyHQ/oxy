+}
+
+function UsageSection({
+  usage,
+  palette,
+  format,
+  expanded,
+  onToggle,
+  label,
+  freeSpaceLabel,
+  testID,
+}: {
+  usage: UsageData;
+  palette: CardPalette;
+  format: (n: number) => string;
+  expanded: boolean;
+  onToggle: () => void;
+  label: string;
+  freeSpaceLabel: string;
+  testID?: string;
