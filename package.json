    "format": "biome format --write .",
    "validate:no-flat-account-list": "bun ./scripts/validate-no-flat-account-list.mjs && bun ./scripts/test-validate-no-flat-account-list.mjs",
    "build:all": "turbo run build",
    "build:workspaces": "bun run build --filter '*'",
    "start": "cd packages/api && node dist/server.js",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "clean": "turbo run clean",
    "protocol:build": "bun run --filter @oxy.so/protocol build",
    "federation:build": "bun run --filter @oxy.so/federation build",
    "core:build": "bun run --filter @oxy.so/core build",
    "services:build": "bun run --filter @oxy.so/services build",
    "services:dev": "bun run --filter @oxy.so/services dev",
    "services:test": "bun run --filter @oxy.so/services test",
    "expo-splash:build": "bun run --filter @oxy.so/expo-splash build",
    "api:build": "bun run --filter @oxy.so/api build",
    "api:dev": "bun run --filter @oxy.so/api dev",
    "api:start": "bun run --filter @oxy.so/api start",
    "accounts:build": "bun run --filter accounts build",
    "accounts:dev": "bun run --filter accounts start",
    "accounts:start": "bun run --filter accounts start",
    "commons:dev": "bun run --filter commons start",
    "commons:start": "bun run --filter commons start",
    "console:dev": "bun run --filter oxy-console dev",
    "console:build": "bun run --filter oxy-console build"
  },
