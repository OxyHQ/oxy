{
  "name": "@oxy.so/node",
  "version": "1.0.0",
  "description": "Oxy personal data node \u2014 a self-hostable server that stores and serves a user's own signed records (their personal repo) for Oxy to ingest/mirror (Fase 5 decentralization)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "node ../core/scripts/build-workspace-deps.mjs @oxy.so/contracts @oxy.so/protocol @oxy.so/core && tsc",
    "start": "bun dist/index.js",
    "clean": "rm -rf dist",
    "test": "bun test src"
  },
  "keywords": [
    "oxyhq",
    "node",
    "decentralization",
    "signed-records",
    "did",
    "self-sovereign-identity"
  ],
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@oxy.so/contracts": "workspace:*",
    "@oxy.so/core": "workspace:*",
    "@oxy.so/protocol": "workspace:*",
    "express": "catalog:",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "catalog:",
    "@types/node": "^22.20.1",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "typescript": "^5.9.2"
  }
}
