{
  "name": "id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "id.oxy.so — the web identity carrier. Seals an account's self-custody identity under a passkey (WebAuthn PRF); Oxy never holds it.",
  "scripts": {
    "dev": "vite --port 8110 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test worker/headers.test.mjs && jest --passWithNoTests",
    "preview": "vite preview --port 8110",
    "smoke:headers": "node worker/smoke-headers.mjs"
  },
  "dependencies": {
    "@oxy.so/contracts": "workspace:*",
    "@oxy.so/core": "workspace:*",
    "@oxy.so/protocol": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "catalog:",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2",
    "vite": "npm:rolldown-vite@^7.3.1"
  }
}
