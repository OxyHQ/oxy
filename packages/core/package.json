{
  "name": "@oxy.so/core",
  "version": "7.4.0",
  "description": "OxyHQ SDK Foundation \u2014 API client, authentication, cryptographic identity, and shared utilities",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "dist/types/server/index.d.ts"
      ],
      "logger": [
        "dist/types/logger/index.d.ts"
      ],
      "inference": [
        "dist/types/inference/index.d.ts"
      ],
      "session": [
        "dist/types/session/index.d.ts"
      ],
      "crypto": [
        "dist/types/crypto/index.d.ts"
      ],
      "civic": [
        "dist/types/civic/index.d.ts"
      ],
      "server/aws": [
        "dist/types/aws/index.d.ts"
      ]
    }
  },
  "source": "src/index.ts",
  "sideEffects": [
    "./dist/esm/crypto/polyfill.js",
    "./dist/cjs/crypto/polyfill.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./server": {
      "import": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/cjs/server/index.js"
      },
      "default": "./dist/esm/server/index.js"
    },
    "./logger": {
      "react-native": "./dist/esm/logger/index.js",
      "import": {
        "types": "./dist/types/logger/index.d.ts",
        "default": "./dist/esm/logger/index.js"
      },
      "require": {
        "types": "./dist/types/logger/index.d.ts",
        "default": "./dist/cjs/logger/index.js"
      },
      "default": "./dist/esm/logger/index.js"
    },
    "./inference": {
      "react-native": "./dist/esm/inference/index.js",
      "import": {
        "types": "./dist/types/inference/index.d.ts",
        "default": "./dist/esm/inference/index.js"
      },
      "require": {
        "types": "./dist/types/inference/index.d.ts",
        "default": "./dist/cjs/inference/index.js"
      },
      "default": "./dist/esm/inference/index.js"
    },
    "./session": {
      "react-native": "./dist/esm/session/index.js",
      "import": {
        "types": "./dist/types/session/index.d.ts",
        "default": "./dist/esm/session/index.js"
      },
      "require": {
        "types": "./dist/types/session/index.d.ts",
        "default": "./dist/cjs/session/index.js"
      },
      "default": "./dist/esm/session/index.js"
    },
    "./crypto": {
      "react-native": "./dist/esm/crypto/index.js",
      "import": {
        "types": "./dist/types/crypto/index.d.ts",
        "default": "./dist/esm/crypto/index.js"
      },
      "require": {
        "types": "./dist/types/crypto/index.d.ts",
        "default": "./dist/cjs/crypto/index.js"
      },
      "default": "./dist/esm/crypto/index.js"
    },
    "./civic": {
      "react-native": "./dist/esm/civic/index.js",
      "import": {
        "types": "./dist/types/civic/index.d.ts",
        "default": "./dist/esm/civic/index.js"
      },
      "require": {
        "types": "./dist/types/civic/index.d.ts",
        "default": "./dist/cjs/civic/index.js"
      },
      "default": "./dist/esm/civic/index.js"
    },
    "./package.json": "./package.json",
    "./server/aws": {
      "import": {
        "types": "./dist/types/aws/index.d.ts",
        "default": "./dist/esm/aws/index.js"
      },
      "require": {
        "types": "./dist/types/aws/index.d.ts",
        "default": "./dist/cjs/aws/index.js"
      }
    }
  },
  "files": [
    "NOTICE",
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/.oxy-source-digest"
  ],
  "oxySourceStamp": "dist",
  "keywords": [
    "oxyhq",
    "sdk",
    "authentication",
    "api-client",
    "crypto",
    "identity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/oxy.git",
    "directory": "packages/core"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://oxy.so",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build-workspace-deps.mjs @oxy.so/telemetry && bun run build:cjs && bun run build:esm && bun run build:types && node scripts/mark-module-formats.mjs && node -e \"const p='../app-preset/metro/source-stamp.js';require('node:fs').existsSync(p)&&require(p).writeStamp(process.cwd())\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "typescript": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "postbuild": "node scripts/verify-package-formats.mjs",
    "verify:package": "node scripts/verify-package-formats.mjs",
    "lint": "biome lint --error-on-warnings ./src",
    "generate:display-name-policy": "node scripts/generateDisplayNamePolicyRanges.mjs",
    "test:bun": "cd bun-tests && bun test"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@oxy.so/contracts": "workspace:6.0.0",
    "@oxy.so/protocol": "workspace:^",
    "@oxy.so/telemetry": "workspace:^",
    "@scure/bip39": "^1.6.0",
    "buffer": "^6.0.3",
    "express-rate-limit": "catalog:",
    "helmet": "^8.0.0",
    "invariant": "^2.2.4",
    "jwt-decode": "^4.0.0",
    "socket.io-client": "catalog:",
    "tldts": "^7.4.10",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "<3.0.0",
    "expo-crypto": "<59.0.0",
    "expo-secure-store": "<59.0.0",
    "express": "^4.0.0",
    "@aws-sdk/credential-provider-node": ">=3.972.83 <4"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@aws-sdk/credential-provider-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/express": "catalog:",
    "@types/invariant": "^2.2.34",
    "@types/node": "^20.19.43",
    "expo-crypto": "~56.0.3",
    "expo-secure-store": "~57.0.4",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "jest": "^30.5.1",
    "regexpu-core": "^6.4.0",
    "typescript": "^5.9.2",
    "helmet": "catalog:",
    "socket.io": "^4.8.1",
    "@aws-sdk/credential-provider-node": "catalog:"
  }
}
