    "expo-image-manipulator": "catalog:",
    "expo-linear-gradient": "catalog:",
    "expo-notifications": "catalog:",
    "expo-clipboard": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "catalog:",
    "socket.io-client": "catalog:",
    "zustand": "catalog:",
    "@clarity.surf/sdk": "0.11.0",
    "axios": "catalog:",
    "@react-native-community/netinfo": "*",
