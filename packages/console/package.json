{
  "name": "oxy-console",
  "private": true,
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "RCT_METRO_PORT=8106 expo start",
    "dev": "RCT_METRO_PORT=8106 expo start --web",
    "web": "RCT_METRO_PORT=8106 expo start --web",
    "build": "node scripts/export-web.js && bun ../core/scripts/writePagesHeaders.ts dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && expo lint",
    "lint:expo": "expo lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
