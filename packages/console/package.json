    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-expo": "catalog:",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "catalog:",
    "tailwindcss": "4.3.4",
    "ts-jest": "^29.4.15",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "expo-video",
        "react",
        "react-dom",
