{
  "name": "@oxy.so/app-preset",
  "version": "3.3.0",
  "description": "The Oxy distro of Expo \u2014 centralized Expo config plugin, Metro/Babel/ESLint factories, Tailwind base CSS and TypeScript bases shared by every Oxy app (Mention, Homiio, Allo, accounts, \u2026). A zero-build package: apps replace copy-pasted config with a single dependency bump.",
  "main": "./app.plugin.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin/withOxyAppPreset": "./plugin/withOxyAppPreset.js",
    "./plugin/withOxyKeychain": "./plugin/withOxyKeychain.js",
    "./plugin/withOxyBuildProperties": "./plugin/withOxyBuildProperties.js",
    "./plugin/withOxyAndroidRelease": "./plugin/withOxyAndroidRelease.js",
    "./plugin/withOxyAndroidWebp": "./plugin/withOxyAndroidWebp.js",
    "./plugin/withOxyUpdates": "./plugin/withOxyUpdates.js",
    "./metro": "./metro/index.js",
    "./babel": "./babel/index.js",
    "./eslint": "./eslint/index.js",
    "./base.css": "./css/base.css",
    "./css/base.css": "./css/base.css",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/frontend.json": "./tsconfig/frontend.json",
    "./tsconfig/backend.json": "./tsconfig/backend.json",
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "app.plugin.js",
    "plugin",
    "metro",
    "babel",
    "build-id",
    "eslint",
    "certs",
    "css",
    "tsconfig",
    "README.md"
  ],
  "keywords": [
    "oxyhq",
    "expo",
    "react-native",
    "config-plugin",
    "metro",
    "babel",
    "nativewind",
    "preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/oxy.git",
    "directory": "packages/app-preset"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://oxy.so",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs",
    "test": "node --test __tests__/*.test.js"
  },
  "//peerDependencies": "THE TWO @oxy.so PEERS ARE DELIBERATE. This package couples to them by FILE PATH, not by API: `css/base.css` imports `@oxy.so/bloom/design-tokens/theme.css`, and `plugin/withOxyAppPreset.js` requires `@oxy.so/services/plugins/withOxySharedPermissions` (services 11+, where it first exists, so the services floor is the major that ships it). Both peers retain a measured floor and are deliberately OPEN-ENDED above it: Oxy apps always run the latest Bloom and Services, so a new release of either must never need a preset release first. A release that breaks this package's file-path coupling is caught by its own tests and the apps' CI, not by a cap. Never replace either constraint with `*`.",
  "peerDependencies": {
    "@oxy.so/bloom": "^2.0.0 || ^3.0.0 || ^4.2.0 || ^5.1.0 || >=6.0.0",
    "@oxy.so/services": ">=11.0.0",
    "babel-plugin-module-resolver": "*",
    "babel-preset-expo": "*",
    "eslint": ">=9.0.0",
    "eslint-config-expo": "*",
    "expo": ">=56.0.0",
    "expo-build-properties": "*",
    "nativewind": ">=5.0.0-preview.0",
    "react-native-webgpu": ">=0.5.18 <1.0.0",
    "react-native-worklets": "*",
    "sharp": ">=0.33.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "expo": "catalog:",
    "nativewind": "catalog:",
    "tailwindcss": "4.3.3"
  },
  "peerDependenciesMeta": {
    "@oxy.so/bloom": {
      "optional": true
    },
    "babel-plugin-module-resolver": {
      "optional": true
    },
    "babel-preset-expo": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-config-expo": {
      "optional": true
    },
    "expo-build-properties": {
      "optional": true
    },
    "react-native-webgpu": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
