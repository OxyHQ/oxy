{
  "name": "@oxy.so/protocol",
  "version": "1.5.1",
  "description": "Oxy Protocol — the app-agnostic base substrate: signed-record envelope, canonical JSON, signature/verification, and platform crypto. Reused by any Oxy app to decentralize its own content.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "secp256k1": [
        "dist/types/secp256k1.d.ts"
      ],
      "node": [
        "dist/types/node/index.d.ts"
      ],
      "random": [
        "dist/types/random.d.ts"
      ],
      "sign": [
        "dist/types/sign.d.ts"
      ]
    }
  },
  "source": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./node": {
      "import": {
        "types": "./dist/types/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/types/node/index.d.ts",
        "default": "./dist/cjs/node/index.js"
      },
      "default": "./dist/esm/node/index.js"
    },
    "./secp256k1": {
      "react-native": "./dist/esm/secp256k1.js",
      "import": {
        "types": "./dist/types/secp256k1.d.ts",
        "default": "./dist/esm/secp256k1.js"
      },
      "require": {
        "types": "./dist/types/secp256k1.d.ts",
        "default": "./dist/cjs/secp256k1.js"
      },
      "default": "./dist/esm/secp256k1.js"
    },
    "./random": {
      "react-native": "./dist/esm/random.js",
      "import": {
        "types": "./dist/types/random.d.ts",
        "default": "./dist/esm/random.js"
      },
      "require": {
        "types": "./dist/types/random.d.ts",
        "default": "./dist/cjs/random.js"
      },
      "default": "./dist/esm/random.js"
    },
    "./sign": {
      "react-native": "./dist/esm/sign.js",
      "import": {
        "types": "./dist/types/sign.d.ts",
        "default": "./dist/esm/sign.js"
      },
      "require": {
        "types": "./dist/types/sign.d.ts",
        "default": "./dist/cjs/sign.js"
      },
      "default": "./dist/esm/sign.js"
    },
    "./package.json": "./package.json"
  },
  "react-native": {
    "./dist/esm/platform/crypto.js": "./dist/esm/platform/crypto.native.js",
    "./dist/cjs/platform/crypto.js": "./dist/cjs/platform/crypto.native.js",
    "./dist/esm/platform/random.js": "./dist/esm/platform/random.native.js",
    "./dist/cjs/platform/random.js": "./dist/cjs/platform/random.native.js"
  },
  "files": [
    "NOTICE",
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src"
  ],
  "keywords": [
    "oxyhq",
    "protocol",
    "signed-records",
    "canonical-json",
    "crypto",
    "did"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/oxy.git",
    "directory": "packages/protocol"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://oxy.so",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run build:cjs && bun run build:esm && bun run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "typescript": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "biome lint --error-on-warnings ./src"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@oxy.so/contracts": "workspace:^",
    "zod": "^3.25.64"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "<3.0.0",
    "expo-crypto": "<59.0.0",
    "expo-secure-store": "<59.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "expo-modules-core": "<59.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/express": "catalog:",
    "@types/node": "^22.20.1",
    "@types/supertest": "catalog:",
    "expo-crypto": "~56.0.3",
    "expo-modules-core": "catalog:",
    "expo-secure-store": "~57.0.4",
    "express": "catalog:",
    "jest": "^30.5.1",
    "supertest": "catalog:",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2"
  }
}
