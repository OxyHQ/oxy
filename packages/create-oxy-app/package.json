{
  "name": "create-oxy-app",
  "version": "0.8.1",
  "description": "Scaffold a new Oxy ecosystem app — an Expo/React Native + Express monorepo wired to the Oxy SDK (@oxy.so/services, @oxy.so/app-preset) with the canonical provider stack, device-first auth, Bloom theming, and AWS deploy. Run with `bun create oxy-app` or `bunx create-oxy-app`.",
  "type": "commonjs",
  "bin": {
    "create-oxy-app": "dist/index.js"
  },
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "NOTICE",
    "dist",
    "templates",
    "README.md"
  ],
  "keywords": [
    "oxyhq",
    "expo",
    "react-native",
    "scaffold",
    "create",
    "monorepo",
    "generator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/oxy.git",
    "directory": "packages/create-oxy-app"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://oxy.so",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.2"
  }
}
