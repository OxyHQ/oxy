{
  "name": "@oxy.so/contracts",
  "version": "5.6.0",
  "description": "OxyHQ API contracts \u2014 single source of truth for request/response Zod schemas and inferred types, shared by the backend and the client SDKs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "client": [
        "dist/types/client/index.d.ts"
      ]
    }
  },
  "source": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./client": {
      "react-native": "./dist/esm/client/index.js",
      "import": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/esm/client/index.js"
      },
      "require": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/cjs/client/index.js"
      },
      "default": "./dist/esm/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "oxyhq",
    "sdk",
    "contracts",
    "zod",
    "schemas",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/oxy.git",
    "directory": "packages/contracts"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://oxy.so",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run check:profile-colors && bun run build:cjs && bun run build:esm && bun run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "typescript": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "biome lint --error-on-warnings ./src",
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs && bun run clean && bun run build",
    "generate:profile-colors": "node scripts/generate-profile-colors.mjs",
    "check:profile-colors": "node scripts/generate-profile-colors.mjs --check"
  },
  "dependencies": {
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jest": "^30.5.1",
    "typescript": "^5.9.2",
    "@oxy.so/bloom": "catalog:"
  }
}
