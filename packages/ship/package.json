{
  "name": "@oxy.so/ship",
  "version": "1.1.0",
  "description": "oxy-ship — publish Expo OTA updates to the Oxy Updates service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/oxy.git",
    "directory": "packages/ship"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "bin": {
    "oxy-ship": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "NOTICE",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/add-shebang.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "oxy-ship": "bun run src/cli.ts"
  },
  "dependencies": {
    "@oxy.so/contracts": "workspace:*",
    "@oxy.so/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
