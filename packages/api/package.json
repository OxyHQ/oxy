{
  "name": "@oxyhq/api",
  "version": "2.0.0",
  "description": "OxyHQ API server with authentication, user management, and real-time features",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "bun --watch src/server.ts",
    "build": "bun run --filter @oxyhq/contracts build && bun run --filter @oxyhq/protocol build && bun run --filter @oxyhq/core build && bun run --filter @oxyhq/federation build && bun run --filter @oxyhq/db build && tsc",
    "clean": "rm -rf dist",
    "migrate:locations": "bun run src/utils/migrateLocations.ts",
    "register:commons-clients": "bun run scripts/register-commons-clients.ts",
    "seed:oxy-applications": "bun run scripts/seed-oxy-applications.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs && bun run clean && bun run build",
    "release": "rm -rf dist && bun run build && release-it",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts --phase=all",
    "seed:store-categories": "bun run scripts/seed-store-categories.ts"
  },
  "release-it": {
    "git": {
      "tagName": "@oxyhq/api@${version}",
      "tagAnnotation": "Release @oxyhq/api@${version}",
      "commitMessage": "chore(api): release @oxyhq/api@${version}"
    },
    "github": {
      "release": true,
      "releaseName": "@oxyhq/api@${version}"
    },
    "npm": {
      "publish": true
    }
  },
  "keywords": [
    "api",
    "express",
    "socket.io",
    "authentication",
    "oxyhq"
  ],
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/lib-storage": "3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@oxyhq/contracts": "workspace:*",
    "@oxyhq/core": "workspace:*",
    "@oxyhq/db": "workspace:*",
    "@oxyhq/federation": "workspace:*",
    "@oxyhq/protocol": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/elliptic": "catalog:",
    "@types/express": "catalog:",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "axios": "catalog:",
    "bullmq": "^5.80.4",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "elliptic": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "express-slow-down": "^2.0.3",
    "helmet": "catalog:",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.14",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "catalog:",
    "postgres": "catalog:",
    "rate-limit-redis": "^4.3.1",
    "sharp": "catalog:",
    "smtp-server": "^3.19.2",
    "socket.io": "^4.8.1",
    "stripe": "^20.4.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.64"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@expo/code-signing-certificates": "0.0.6",
    "@types/express-slow-down": "^1.3.5",
    "@types/http-errors": "^2.0.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "release-it": "catalog:",
    "socket.io-client": "catalog:",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "catalog:"
  }
}
