{
  "name": "@oxy.so/api",
  "version": "1.0.1",
  "description": "OxyHQ API server with authentication, user management, and real-time features",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "bun --watch src/server.ts",
    "build": "bun run --filter @oxy.so/telemetry build && bun run --filter @oxy.so/contracts build && bun run --filter @oxy.so/protocol build && bun run --filter @oxy.so/core build && bun run --filter @oxy.so/federation build && bun run --filter @oxy.so/db build && bun run --filter @oxy.so/mcp build && tsc",
    "clean": "rm -rf dist",
    "migrate:locations": "bun run src/utils/migrateLocations.ts",
    "register:commons-clients": "bun run scripts/register-commons-clients.ts",
    "register:inbox-catalog": "bun run scripts/register-inbox-capability-catalog.ts",
    "seed:oxy-applications": "bun run scripts/seed-oxy-applications.ts",
    "seed:internal-cost-centers": "bun run scripts/seed-internal-cost-centers.ts",
    "seed:inference-catalogue": "bun run scripts/seed-inference-catalogue.ts",
    "bootstrap:kaana-catalogue": "bun run scripts/bootstrap-kaana-catalogue.ts",
    "bootstrap:catalogue-reviewer": "bun run scripts/bootstrap-catalogue-reviewer.ts",
    "bootstrap:native-product-agents": "bun run scripts/bootstrap-native-product-agents.ts",
    "verify:inference-routing": "bun run scripts/verify-inference-routing-readiness.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage-merge": "node --test scripts/merge-coverage.test.mjs",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs && bun run clean && bun run build",
    "release": "rm -rf dist && bun run build && release-it",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts --phase=all",
    "seed:store-categories": "bun run scripts/seed-store-categories.ts"
  },
  "release-it": {
    "git": {
      "tagName": "@oxy.so/api@${version}",
      "tagAnnotation": "Release @oxy.so/api@${version}",
      "commitMessage": "chore(api): release @oxy.so/api@${version}"
    },
    "github": {
      "release": true,
      "releaseName": "@oxy.so/api@${version}"
    },
    "npm": {
      "publish": true
    }
  },
  "keywords": [
    "api",
    "express",
    "socket.io",
    "authentication",
    "oxyhq"
  ],
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@oxy.so/telemetry": "workspace:*",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/client-ecs": "^3.1087.0",
    "@aws-sdk/lib-storage": "3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@oxy.so/contracts": "workspace:*",
    "@oxy.so/core": "workspace:*",
    "@oxy.so/db": "workspace:*",
    "@oxy.so/federation": "workspace:*",
    "@oxy.so/mcp": "workspace:*",
    "@oxy.so/protocol": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "catalog:",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "catalog:",
    "bullmq": "^5.80.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "express-slow-down": "^2.0.3",
    "helmet": "catalog:",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.23",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "pino": "catalog:",
    "postgres": "catalog:",
    "rate-limit-redis": "^6.0.0",
    "sharp": "catalog:",
    "smtp-server": "^3.19.9",
    "socket.io": "^4.8.1",
    "stripe": "^20.4.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.64"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@expo/code-signing-certificates": "0.0.6",
    "@types/express-slow-down": "^1.3.5",
    "@types/http-errors": "^2.0.4",
    "@types/supertest": "catalog:",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "release-it": "catalog:",
    "socket.io-client": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "catalog:"
  }
}
