{
  "name": "@oxy.so/api",
  "version": "1.0.1",
  "private": true,
  "description": "OxyHQ API server with authentication, user management, and real-time features",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun dist/server.js",
    "start:asset-variant-worker": "bun dist/asset-variant-worker.js",
    "dev": "bun --watch src/server.ts",
    "build": "node ../core/scripts/build-workspace-deps.mjs @oxy.so/utils @oxy.so/telemetry @oxy.so/contracts @oxy.so/protocol @oxy.so/core @oxy.so/federation @oxy.so/db @oxy.so/mcp && tsc",
    "clean": "rm -rf dist",
    "migrate:locations": "bun run src/utils/migrateLocations.ts",
    "register:commons-clients": "bun run scripts/register-commons-clients.ts",
    "register:inbox-catalog": "bun run scripts/register-inbox-capability-catalog.ts",
    "register:oxy-catalog": "bun run scripts/register-oxy-capability-catalog.ts",
    "seed:oxy-applications": "bun run scripts/seed-oxy-applications.ts",
    "seed:internal-cost-centers": "bun run scripts/seed-internal-cost-centers.ts",
    "seed:inference-catalogue": "bun run scripts/seed-inference-catalogue.ts",
    "bootstrap:kaana-catalogue": "bun run scripts/bootstrap-kaana-catalogue.ts",
    "bootstrap:catalogue-reviewer": "bun run scripts/bootstrap-catalogue-reviewer.ts",
    "verify:inference-routing": "bun run scripts/verify-inference-routing-readiness.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage-merge": "node --test scripts/merge-coverage.test.mjs scripts/check-shard-partition.test.mjs",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts --phase=all",
    "bind:workload-identity": "bun run scripts/bind-workload-identity.ts",
    "reconcile:external-identities": "bun run scripts/reconcile-external-identities.ts",
    "seed:store-categories": "bun run scripts/seed-store-categories.ts"
  },
  "keywords": [
    "api",
    "express",
    "socket.io",
    "authentication",
    "oxyhq"
  ],
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@atproto/oauth-client-node": "^0.5.13",
    "@aws-sdk/credential-provider-node": "catalog:",
    "@aws-sdk/credential-provider-ini": "catalog:",
    "@aws-sdk/client-ecs": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@lottiefiles/dotlottie-web": "0.82.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.79.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-socket.io": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@kaana.ai/contracts": "8.2.0",
    "@levischuck/tiny-cbor": "^0.3.6",
    "@oxy.so/bloom": "catalog:",
    "@oxy.so/contracts": "workspace:*",
    "@clarity.surf/sdk": "0.11.0",
    "@oxy.so/core": "workspace:*",
    "@oxy.so/db": "workspace:*",
    "@oxy.so/federation": "workspace:*",
    "@oxy.so/mcp": "workspace:*",
    "@oxy.so/protocol": "workspace:*",
    "@oxy.so/telemetry": "workspace:*",
    "@oxy.so/utils": "workspace:*",
    "@peable.to/sdk": "6.2.0",
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/asn1-x509": "^3.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "catalog:",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "asn1js": "^4.0.0",
    "bullmq": "^6.5.4",
    "compression": "^1.8.2",
    "dompurify": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "express-slow-down": "^3.1.1",
    "helmet": "catalog:",
    "ioredis": "^6.0.0",
    "jsdom": "catalog:",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.14.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "parse5": "8.1.0",
    "pino": "catalog:",
    "postgres": "catalog:",
    "rate-limit-redis": "^6.0.2",
    "sharp": "catalog:",
    "smtp-server": "^3.21.3",
    "socket.io": "^4.8.4",
    "stripe": "^23.1.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.1",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@expo/code-signing-certificates": "0.0.7",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@types/http-errors": "^2.0.5",
    "@types/supertest": "catalog:",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "babel-jest": "^30.5.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "catalog:",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "^29.4.15",
    "typescript": "catalog:"
  }
}
