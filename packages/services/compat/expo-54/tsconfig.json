{
  "compilerOptions": {
    "target": "es2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["index.tsx", "node_modules/@oxy.so/services/src/**/*"],
  "exclude": [
    "node_modules/@oxy.so/services/src/**/__tests__/**",
    "node_modules/@oxy.so/services/src/**/*.test.ts",
    "node_modules/@oxy.so/services/src/**/*.test.tsx"
  ]
}
