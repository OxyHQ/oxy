{
  "name": "@oxy.so/services",
  "version": "10.0.0",
  "description": "OxyHQ Expo/React Native SDK \u2014 UI components, screens, and native features",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./ui": {
      "react-native": "./src/ui/index.ts",
      "import": {
        "types": "./lib/typescript/module/ui/index.d.ts",
        "default": "./lib/module/ui/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/index.d.ts",
        "default": "./lib/commonjs/ui/index.js"
      },
      "default": "./lib/module/ui/index.js"
    },
    "./ui/client": {
      "react-native": "./src/ui/client.ts",
      "import": {
        "types": "./lib/typescript/module/ui/client.d.ts",
        "default": "./lib/module/ui/client.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/client.d.ts",
        "default": "./lib/commonjs/ui/client.js"
      },
      "default": "./lib/module/ui/client.js"
    },
    "./ui/server": {
      "react-native": "./src/ui/server.ts",
      "import": {
        "types": "./lib/typescript/module/ui/server.d.ts",
        "default": "./lib/module/ui/server.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/server.d.ts",
        "default": "./lib/commonjs/ui/server.js"
      },
      "default": "./lib/module/ui/server.js"
    },
    "./screens": {
      "react-native": "./src/ui/screens/index.ts",
      "import": {
        "types": "./lib/typescript/module/ui/screens/index.d.ts",
        "default": "./lib/module/ui/screens/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/screens/index.d.ts",
        "default": "./lib/commonjs/ui/screens/index.js"
      },
      "default": "./lib/module/ui/screens/index.js"
    },
    "./notifications": {
      "react-native": "./src/notifications/deviceNotifications.ts",
      "import": {
        "types": "./lib/typescript/module/notifications/deviceNotifications.d.ts",
        "default": "./lib/module/notifications/deviceNotifications.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/notifications/deviceNotifications.d.ts",
        "default": "./lib/commonjs/notifications/deviceNotifications.js"
      },
      "default": "./lib/module/notifications/deviceNotifications.js"
    },
    "./plugins/*": "./plugins/*.js",
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "src",
    "lib",
    "assets",
    "android/build.gradle",
    "android/src",
    "ios/OxyIdentityModule.swift",
    "ios/OxyIdentity.podspec",
    "plugins",
    "expo-module.config.json"
  ],
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "oxyhq",
    "sdk",
    "authentication",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oxyhq/sdk",
    "directory": "packages/services"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://oxy.so",
  "scripts": {
    "typescript": "tsc --skipLibCheck --noEmit",
    "lint": "biome lint --error-on-warnings ./src",
    "build": "bun run check:icon-fonts && bun x react-native-builder-bob build --target commonjs && bun x react-native-builder-bob build --target module && bun x react-native-builder-bob build --target typescript && bun run copy-assets && bun run copy-dts && bun run delete-dts.js && bun run delete-debug-view",
    "postbuild": "node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "generate:icon-fonts": "node scripts/generate-icon-font-subsets.mjs",
    "check:icon-fonts": "node scripts/check-icon-font-subsets.mjs",
    "build:js": "bun x react-native-builder-bob build --target commonjs && bun x react-native-builder-bob build --target module && bun run copy-assets",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "copy-assets": "copyfiles -u 1 \"src/assets/**/*\" lib/commonjs/assets && copyfiles -u 1 \"src/assets/**/*\" lib/module/assets",
    "copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" lib/typescript",
    "delete-debug-view": "rm -rf ./lib/commonjs/components/bottomSheetDebugView ./lib/module/components/bottomSheetDebugView ./lib/typescript/components/bottomSheetDebugView || true",
    "delete-dts.js": "find ./lib/commonjs -name '*.d.js*' -delete && find ./lib/module -name '*.d.js*' -delete",
    "release": "rm -rf lib && bun run build && release-it",
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs && bun run typescript && bun run test && bun run build"
  },
  "release-it": {
    "git": {
      "tagName": "@oxy.so/services@${version}",
      "tagAnnotation": "Release @oxy.so/services@${version}",
      "commitMessage": "chore(services): release @oxy.so/services@${version}"
    },
    "github": {
      "release": true,
      "releaseName": "@oxy.so/services@${version}"
    },
    "npm": {
      "publish": true
    }
  },
  "dependencies": {
    "@expo/config-plugins": "catalog:",
    "@oxy.so/contracts": "workspace:^",
    "color": "^4.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@expo/vector-icons": "^15.0.3",
    "@oxy.so/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/babel-preset": "^0.86.2",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/query-async-storage-persister": "catalog:",
    "@tanstack/query-sync-storage-persister": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "catalog:",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/color": "^4.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "*",
    "@oxy.so/bloom": "catalog:",
    "copyfiles": "^2.4.1",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-file-system": "catalog:",
    "expo-haptics": "catalog:",
    "expo-image": "catalog:",
    "expo-image-manipulator": "catalog:",
    "expo-linear-gradient": "catalog:",
    "expo-notifications": "catalog:",
    "expo-modules-core": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-web-browser": "catalog:",
    "husky": "^4.3.8",
    "jest": "^30.5.1",
    "lint-staged": "^15.2.4",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "^0.43.0",
    "react-native-css": "^3.0.6",
    "react-native-gesture-handler": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-qrcode-svg": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "release-it": "catalog:",
    "socket.io-client": "catalog:",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2",
    "zustand": "catalog:"
  },
  "//@oxy.so/bloom": "Bloom peer tracks the measured major: ^6.0.0 includes canonical appearance/tone/size props and shared Surface. Keep its upper bound and the root catalog in sync to prevent duplicate context instances. Services 10 removes FollowButton small/medium/large aliases in favor of sm/md/lg.",
  "peerDependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@oxy.so/bloom": "^6.0.0",
    "@oxy.so/core": "^3.2.0",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/netinfo": ">=11.4.1",
    "@tanstack/query-async-storage-persister": "catalog:",
    "@tanstack/query-sync-storage-persister": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "catalog:",
    "@types/react": "*",
    "@types/react-native": "*",
    "expo": ">=56.0.0",
    "expo-clipboard": ">=56.0.0 <59.0.0",
    "expo-constants": ">=56.0.0",
    "expo-document-picker": ">=56.0.0",
    "expo-file-system": ">=56.0.0",
    "expo-haptics": ">=56.0.0",
    "expo-image": ">=2.0.0",
    "expo-image-manipulator": ">=56.0.0",
    "expo-image-picker": ">=56.0.0",
    "expo-linear-gradient": ">=56.0.0",
    "expo-modules-core": "*",
    "expo-notifications": ">=56.0.0",
    "expo-web-browser": ">=56.0.0",
    "nativewind": ">=5.0.0",
    "react-native-css": "^3.0.6",
    "react": ">=18.0.0",
    "react-native": ">=0.85.0",
    "react-native-gesture-handler": ">=2.31.1",
    "react-native-keyboard-controller": ">=1.21.0",
    "react-native-qrcode-svg": "catalog:",
    "react-native-reanimated": ">=4.3.0",
    "react-native-safe-area-context": ">=5.7.0",
    "react-native-svg": ">=15.15.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    },
    "@types/react-native": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "react-native-keyboard-controller": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-image-manipulator": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "@tanstack/query-sync-storage-persister": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
