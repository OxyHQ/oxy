    "expo": ">=54.0.0 <59.0.0",
    "expo-clipboard": ">=8.0.0 <59.0.0",
    "expo-constants": ">=18.0.0 <59.0.0",
    "expo-crypto": ">=15.0.0 <59.0.0",
    "expo-document-picker": ">=14.0.0 <59.0.0",
