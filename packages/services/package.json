    "@expo/vector-icons": "^15.0.3",
    "@oxy.so/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/babel-preset": "^0.88.0",
