{
  "name": "@oxy.so/services",
  "version": "4.0.3",
  "description": "OxyHQ Expo/React Native SDK \u2014 UI components, screens, and native features",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./ui": {
      "react-native": "./src/ui/index.ts",
      "import": {
        "types": "./lib/typescript/module/ui/index.d.ts",
        "default": "./lib/module/ui/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/index.d.ts",
        "default": "./lib/commonjs/ui/index.js"
      },
      "default": "./lib/module/ui/index.js"
    },
    "./ui/client": {
      "react-native": "./src/ui/client.ts",
      "import": {
        "types": "./lib/typescript/module/ui/client.d.ts",
        "default": "./lib/module/ui/client.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/client.d.ts",
        "default": "./lib/commonjs/ui/client.js"
      },
      "default": "./lib/module/ui/client.js"
    },
    "./ui/server": {
      "react-native": "./src/ui/server.ts",
      "import": {
        "types": "./lib/typescript/module/ui/server.d.ts",
        "default": "./lib/module/ui/server.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/server.d.ts",
        "default": "./lib/commonjs/ui/server.js"
      },
      "default": "./lib/module/ui/server.js"
    },
    "./screens": {
      "react-native": "./src/ui/screens/index.ts",
      "import": {
        "types": "./lib/typescript/module/ui/screens/index.d.ts",
        "default": "./lib/module/ui/screens/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/screens/index.d.ts",
        "default": "./lib/commonjs/ui/screens/index.js"
      },
      "default": "./lib/module/ui/screens/index.js"
    },
    "./notifications": {
      "react-native": "./src/notifications/deviceNotifications.ts",
      "import": {
        "types": "./lib/typescript/module/notifications/deviceNotifications.d.ts",
        "default": "./lib/module/notifications/deviceNotifications.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/notifications/deviceNotifications.d.ts",
        "default": "./lib/commonjs/notifications/deviceNotifications.js"
      },
      "default": "./lib/module/notifications/deviceNotifications.js"
    },
    "./plugins/*": "./plugins/*.js",
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "src",
    "lib",
    "assets",
    "android/build.gradle",
    "android/src",
    "ios/OxyIdentityModule.swift",
    "ios/OxyIdentity.podspec",
    "plugins",
    "expo-module.config.json"
  ],
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "oxyhq",
    "sdk",
    "authentication",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oxyhq/sdk",
    "directory": "packages/services"
  },
  "author": "OxyHQ",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://oxy.so",
  "scripts": {
    "typescript": "tsc --skipLibCheck --noEmit",
    "lint": "biome lint --error-on-warnings ./src",
    "build": "bun run check:icon-fonts && bun x react-native-builder-bob build --target commonjs && bun x react-native-builder-bob build --target module && bun x react-native-builder-bob build --target typescript && bun run copy-assets && bun run copy-dts && bun run delete-dts.js && bun run delete-debug-view",
    "postbuild": "node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "generate:icon-fonts": "node scripts/generate-icon-font-subsets.mjs",
    "check:icon-fonts": "node scripts/check-icon-font-subsets.mjs",
    "build:js": "bun x react-native-builder-bob build --target commonjs && bun x react-native-builder-bob build --target module && bun run copy-assets",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "copy-assets": "copyfiles -u 1 \"src/assets/**/*\" lib/commonjs/assets && copyfiles -u 1 \"src/assets/**/*\" lib/module/assets",
    "copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" lib/typescript",
    "delete-debug-view": "rm -rf ./lib/commonjs/components/bottomSheetDebugView ./lib/module/components/bottomSheetDebugView ./lib/typescript/components/bottomSheetDebugView || true",
    "delete-dts.js": "find ./lib/commonjs -name '*.d.js*' -delete && find ./lib/module -name '*.d.js*' -delete",
    "release": "rm -rf lib && bun run build && release-it",
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs && bun run typescript && bun run test && bun run build"
  },
  "release-it": {
    "git": {
      "tagName": "@oxy.so/services@${version}",
      "tagAnnotation": "Release @oxy.so/services@${version}",
      "commitMessage": "chore(services): release @oxy.so/services@${version}"
    },
    "github": {
      "release": true,
      "releaseName": "@oxy.so/services@${version}"
    },
    "npm": {
      "publish": true
    }
  },
