    "expo-image-picker": ">=17.0.0 <59.0.0",
    "expo-linear-gradient": ">=15.0.0 <59.0.0",
    "expo-modules-core": "<59.0.0",
    "expo-notifications": ">=0.32.0 <59.0.0",
    "expo-secure-store": ">=15.0.0 <59.0.0",
    "expo-web-browser": ">=15.0.0 <59.0.0",
    "nativewind": ">=5.0.0-preview.3 <6.0.0",
    "react-native-css": "^3.0.6 || 3.1.0-rc.0",
    "react": ">=18.0.0 <20.0.0",
