    "expo-secure-store": "catalog:",
    "expo-web-browser": "catalog:",
    "husky": "^4.3.8",
    "jest": "^30.5.1",
    "lint-staged": "^15.2.4",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "^0.43.0",
    "react-native-css": "catalog:",
