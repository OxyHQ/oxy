{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!.worktrees",
      "!**/dist",
      "!**/coverage",
      "!**/.expo",
      "!**/.next",
      "!**/drizzle/meta",
      "!**/*.generated.*",
      // Committed evidence, audit records and ADRs: byte-for-byte records, not source.
      "!docs",
      // Sealed native forks: vendor tarballs, the tooling fork that
      // scripts/verify-native-expo-forks.py compares against its archive, and patches.
      "!vendor",
      "!tooling",
      "!patches",
      // Migrations and their snapshots are generated by drizzle-kit and checked
      // by the migration journal and phase guards.
      "!packages/api/drizzle",
      // Generated and checked by scripts/check-openapi-fresh.mjs.
      "!packages/api/openapi.json",
      // Written by the Jest sharder from measured runs.
      "!packages/api/test-durations.json",
      // Generated by TanStack Router.
      "!packages/console/src/routeTree.gen.ts",
      // Copied verbatim into scaffolded apps, which bring their own toolchain.
      "!packages/create-oxy-app/templates",
      // ESM syntax in a `.js` file of a CommonJS package (it runs under bun:test);
      // Biome parses it as a script and refuses it.
      "!packages/create-oxy-app/src/__tests__/bloomPair.test.js",
      // Recorded fixtures, golden files and test vectors compared as data.
      "!**/__fixtures__",
      "!**/*.golden.json",
      "!packages/commons/modules/oxy-identity-host/vectors.json",
      "!.github/scripts/decisions-release-smoke/fixtures.json",
      // Exported Lottie animations.
      "!**/assets/lottie"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Baseline: recommended rules that fire on existing code at error level,
      // lowered to warn so `biome ci .` passes. Tightening follow-ups.
      "a11y": {
        "noRedundantAlt": "warn",
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "useHtmlLang": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn"
      },
      "correctness": {
        "noUnsafeOptionalChaining": "warn",
        "useYield": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noDoubleEquals": "warn",
        "noDuplicateElseIf": "warn",
        "noDuplicateObjectKeys": "warn",
        "noEmptyInterface": "warn",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "overrides": [
    {
      // Formatter OFF, lint on: source whose exact layout a gate or test reads as
      // text. Formatting any of these turns a check red without a behaviour change.
      "includes": [
        // scripts/test-service-credential-workflow-ids.mjs (regex over the registry).
        "packages/api/src/utils/serviceCredentialScopeRotations.ts",
        // scripts/check-inbox-daily-brief.mjs (route slice and contract regexes).
        "packages/api/src/routes/inboxInference.ts",
        "packages/contracts/src/inference/inbox.ts",
        // src/routes/__tests__/workloadMintRateLimit.test.ts (route-registration regex).
        "packages/api/src/routes/auth.ts",
        // src/scripts/__tests__/{inbox,jev}Principal(s)Readback.test.ts (normalised source).
        "packages/api/scripts/readback-inbox-principal.ts",
        "packages/api/scripts/readback-jev-principals.ts",
        // packages/commons/__tests__/app/root-layout.test.ts (call-shape regex).
        "packages/commons/app/_layout.tsx",
        // Content-hashed: its sha256 is in src/assets/fonts/icons/manifest.json,
        // checked by `check:icon-fonts` before every services build.
        "packages/services/src/ui/icons/subsetGlyphMaps.ts",
        // packages/contracts usernamePolicySingleSource census: a ±6-line window
        // between a handle-shaped character class and the word username/handle.
        "packages/services/src/ui/oauth/explicitOAuthConsent.ts",
        "packages/mcp/src/internalTransport.ts",
        "packages/telemetry/src/edge.ts",
        "packages/api/src/services/externalProfileInspection.service.ts",
        // Read as text by the Guards job's deploy-script tests: scripts/test-service-
        // credential-{workflow-ids,two-phase}.mjs, test-native-product-agent-bootstrap-
        // workflow.mjs, test-kaana-catalogue-bootstrap-workflow.mjs and the
        // check-kaana-{request-v2-rollout,signed-canary,catalogue-bootstrap-workflow},
        // check-inbox-routing-profile-readback gates (and their tests).
        "packages/api/scripts/bootstrap-kaana-catalogue.ts",
        "packages/api/scripts/bootstrap-native-product-agents.ts",
        "packages/api/scripts/create-service-credential.ts",
        "packages/api/scripts/finalize-service-credential.ts",
        "packages/api/scripts/readback-inbox-routing-profile.ts",
        "packages/api/scripts/reconcile-service-credential-authority.ts",
        "packages/api/scripts/run-kaana-signed-canary.mjs",
        "packages/api/src/scripts/kaanaCatalogueBootstrapPlan.ts",
        "packages/api/src/services/inferenceEdge.service.ts",
        "packages/api/src/utils/serviceCredentialFinalization.ts",
        "packages/contracts/src/inference/privateAutoExecution.ts",
        "packages/contracts/src/inference/request.ts",
        "packages/contracts/src/inference/routingPolicy.ts"
      ],
      "formatter": { "enabled": false }
    },
    {
      // packages/api, ported from its ESLint config (typescript-eslint recommended,
      // error level): no-require-imports, no-namespace, no-unused-expressions.
      // ESLint ignored scripts/**, *.cjs and turned require off for jest.config.js.
      "includes": [
        "packages/api/**",
        "!packages/api/scripts/**",
        "!packages/api/**/*.cjs",
        "!packages/api/jest.config.js"
      ],
      "linter": {
        "rules": {
          "style": { "noCommonJs": "error", "noNamespace": "error" },
          "suspicious": { "noUnusedExpressions": "error" }
        }
      }
    },
    {
      // packages/api: no-var (error) and no-console (warn, allowing warn/error).
      "includes": ["packages/api/**/*.ts", "packages/api/**/*.tsx", "!packages/api/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noVar": "error",
            "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } }
          }
        }
      }
    },
    {
      // Commons: every glyph is a Bloom SVG from `@/constants/icons`. An icon font
      // ships its whole TTF for one glyph, and TalkBack reads its private-use code point.
      "includes": [
        "packages/commons/**/*.ts",
        "packages/commons/**/*.tsx",
        "packages/commons/**/*.js",
        "packages/commons/**/*.jsx",
        "!packages/commons/__mocks__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@expo/vector-icons", "@expo/vector-icons/*"],
                    "message": "Draw glyphs from @/constants/icons (Bloom SVGs), not an icon font."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Console (@tanstack/eslint-config) and test-app-vite (eslint/typescript-eslint
      // recommended) had these at error level; Biome does not enable them by default.
      "includes": ["packages/console/**", "packages/test-app-vite/**"],
      "linter": {
        "rules": {
          "style": { "useConst": "error", "noNamespace": "error" },
          "suspicious": { "noVar": "error" }
        }
      }
    },
    {
      // Console: import/no-commonjs and node/prefer-node-protocol were errors.
      "includes": ["packages/console/**"],
      "linter": {
        "rules": {
          "style": { "noCommonJs": "error", "useNodejsImportProtocol": "error" }
        }
      }
    },
    {
      // These packages run `biome lint --error-on-warnings ./src`, so a warning
      // fails them. Recommended rules that fire on their existing code are off
      // here (baseline); everything else stays fatal. Tightening follow-ups.
      "includes": [
        "packages/contracts/src/**",
        "packages/core/src/**",
        "packages/db/src/**",
        "packages/federation/src/**",
        "packages/mcp/src/**",
        "packages/protocol/src/**",
        "packages/services/src/**",
        "packages/stickers/src/**",
        "packages/telemetry/src/**",
        "packages/utils/src/**"
      ],
      "linter": {
        "rules": {
          "a11y": { "noSvgWithoutTitle": "off" },
          "complexity": { "useDateNow": "off", "useOptionalChain": "off" },
          "correctness": {
            "noUnsafeOptionalChaining": "off",
            "noUnusedFunctionParameters": "off",
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "useHookAtTopLevel": "off"
          },
          "suspicious": { "noPrototypeBuiltins": "off", "useIterableCallbackReturn": "off" }
        }
      }
    }
  ]
}
